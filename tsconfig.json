{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": [
    "node_modules",
    "src/mastra/agents/weather-agent.ts",
    "src/mastra/tools/weather-tool.ts",
    "src/mastra/workflows/weather-workflow.ts",
    "src/mastra/scorers/weather-scorer.ts"
  ]
}
